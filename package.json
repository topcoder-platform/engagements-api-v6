{
  "name": "engagements-api-v6",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "prebuild": "pnpm run prisma:generate",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:external-client": "node --test packages/engagements-prisma-client/factory.test.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "deploy:dev": "BRANCH=$(git rev-parse --abbrev-ref HEAD) && TAG=\"dev-${BRANCH}\" && git tag -d \"$TAG\" 2>/dev/null; git push origin \":refs/tags/$TAG\" 2>/dev/null; git tag \"$TAG\" && git push origin \"$TAG\"",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:dependency-compat": "node --test tools/minimatch-compat/index.test.cjs",
    "prelint": "pnpm run prisma:generate"
  },
  "dependencies": {
    "@nestjs/axios": "12.0.2",
    "@nestjs/common": "12.6.3",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.6.3",
    "@nestjs/platform-express": "12.6.3",
    "@nestjs/schedule": "12.0.4",
    "@nestjs/swagger": "12.1.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "axios": "^1.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cron": "4.4.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "i18n-iso-countries": "^3.7.1",
    "json-stringify-safe": "^5.0.1",
    "nanoid": "^5.1.16",
    "pg": "^8.16.3",
    "prisma": "7.10.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.2",
    "tc-core-library-js": "https://codeload.github.com/topcoder-platform/tc-core-library-js/tar.gz/c2df92b2227089909ab6e229df0ec6b658bb431a"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "12.0.15",
    "@nestjs/schematics": "12.0.16",
    "@nestjs/testing": "12.6.3",
    "@types/express": "^5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "^20.11.24",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.1.3",
    "globals": "^16.3.0",
    "jest": "30.5.2",
    "prettier": "^3.2.5",
    "supertest": "^7.0.0",
    "ts-jest": "29.4.15",
    "ts-node": "^10.9.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.64.0"
  }
}
