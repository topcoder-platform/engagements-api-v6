# ========================================
# APPLICATION PORT
# ========================================
PORT=3000

# ========================================
# POSTGRESQL DATABASE
# ========================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/engagements"

# ========================================
# AUTHENTICATION
# ========================================
AUTH_SECRET="your-local-dev-secret-key-placeholder"
VALID_ISSUERS='["https://api.topcoder-dev.com"]'

# ========================================
# EXTERNAL SERVICES
# ========================================
TOPCODER_API_URL_BASE=https://api.topcoder-dev.com
# Derived endpoints:
# - TC_PROJECT_SERVICE_URL: ${TOPCODER_API_URL_BASE}/v6/projects
# - STANDARDIZED_SKILLS_API_URL: ${TOPCODER_API_URL_BASE}/v5/standardized-skills
# - MEMBER_API_V6_URL: ${TOPCODER_API_URL_BASE}/v6/members
# Standardized-skills category for skills created from lead intake skill names that have no
# standardized match (POST /v5/standardized-skills/skills with the M2M credentials below).
STANDARDIZED_SKILLS_NEW_SKILL_CATEGORY_ID=
# - Finance API: ${TOPCODER_API_URL_BASE}/v6/finance (override with FINANCE_API_URL). Read with the
#   M2M credentials below, which need the read:payments scope, for timesheet hours left.
# PLATFORM UI BASE URL (used to generate anonymous feedback links)
PLATFORM_UI_BASE_URL=http://localhost:3001
# In production use https://platform.topcoder.com or https://platform.topcoder-dev.com

# ========================================
# FLEXI TALENT
# ========================================
# Comma-separated Work project IDs excluded from Flexi Talent responses.
FLEXI_TALENT_IGNORED_PROJECT_IDS=38965,1001006,1000636,37220,34654,1001120

# ========================================
# TIMESHEETS
# ========================================
# Comma-separated Work project IDs (e.g. test projects) excluded from the timesheet landing list.
TIMESHEET_IGNORED_PROJECT_IDS=

# ========================================
# TEST PROJECTS
# ========================================
# Comma-separated Work project IDs the Work App hides when "Hide test projects" is checked
# (excludeTestProjects=true on GET /engagements and GET /timesheets/approved).
TEST_PROJECT_IDS=

# ========================================
# EVENT BUS
# ========================================
BUS_API_URL=https://api.topcoder-dev.com/eventBus
KAFKA_ERROR_TOPIC=common.error.reporting

# ========================================
# EMAIL
# ========================================
SENDGRID_ASSIGNMENT_OFFER_TEMPLATE_ID=
SENDGRID_ENGAGEMENT_ASSIGNMENT_UPDATED_TEMPLATE_ID=
SENDGRID_ASSIGNMENT_OFFER_ACCEPTED_TEMPLATE_ID=
SENDGRID_ASSIGNMENT_OFFER_REJECTED_TEMPLATE_ID=
# SendGrid template for notifying applicants their application is under review.
SENDGRID_UNDER_REVIEW_TEMPLATE_ID=
# SendGrid template for notifying applicants their application was not selected.
SENDGRID_REJECTED_TEMPLATE_ID=
# Tells a member their application was revoked when a selected assignment they had not accepted is removed (docs/emails/application-revoked.html).
SENDGRID_APPLICATION_REVOKED_TEMPLATE_ID=
# Timesheet workflow emails. Each one is disabled while its template ID is empty.
SENDGRID_TIMESHEET_SUBMITTED_TEMPLATE_ID=
SENDGRID_TIMESHEET_RESUBMISSION_REQUIRED_TEMPLATE_ID=
SENDGRID_TIMESHEET_APPROVED_TEMPLATE_ID=
SENDGRID_TIMESHEET_ADMIN_CHANGED_TEMPLATE_ID=
# Tells a member an administrator moved submitted entries back to draft (docs/emails/timesheet-reverted-to-draft.html).
SENDGRID_TIMESHEET_REVERTED_TO_DRAFT_TEMPLATE_ID=
# Tell the managers and the member the system auto-approved a submission
# (docs/emails/timesheet-auto-approved-manager.html, docs/emails/timesheet-auto-approved-member.html).
SENDGRID_TIMESHEET_AUTO_APPROVED_MANAGER_TEMPLATE_ID=
SENDGRID_TIMESHEET_AUTO_APPROVED_MEMBER_TEMPLATE_ID=
# Timesheet auto-approval (docs/TIMESHEET_WORKFLOW.md, Auto-approval). Off unless ENABLED is true.
TIMESHEET_AUTO_APPROVAL_ENABLED=false
# Cron expression, UTC. Defaults to daily at 02:00.
TIMESHEET_AUTO_APPROVAL_CRON=0 2 * * *
TIMESHEET_AUTO_APPROVAL_PENDING_DAYS=7
# Only timesheets submitted on or after this day (YYYY-MM-DD, UTC) are auto-approved. Defaults to 2026-11-24.
TIMESHEET_AUTO_APPROVAL_START_DATE=2026-11-24
# Tells a member a manager returned submitted entries for corrections (docs/emails/timesheet-returned-for-corrections.html).
SENDGRID_TIMESHEET_RETURNED_FOR_CORRECTIONS_TEMPLATE_ID=
SENDGRID_ENGAGEMENT_MANAGER_ASSIGNED_TEMPLATE_ID=
# Admin-triggered reminder to managers about timesheets awaiting approval (docs/emails/timesheet-approval-reminder.html).
SENDGRID_TIMESHEET_APPROVAL_REMINDER_TEMPLATE_ID=
# Admin-triggered reminder to members about timesheets not submitted (docs/emails/timesheet-submission-reminder.html).
SENDGRID_TIMESHEET_SUBMISSION_REMINDER_TEMPLATE_ID=
# Emails the Flexi Talent Managers when an engagement lead is submitted. Disabled while empty.
SENDGRID_ENGAGEMENT_LEAD_SUBMITTED_TEMPLATE_ID=
# Identity role whose members receive the lead submitted email.
FLEXI_TALENT_MANAGER_ROLE_NAME=Flexi Talent Manager
# Optional work app base URL for the lead link; derived from TOPCODER_API_URL_BASE when empty.
WORK_APP_BASE_URL=

# ========================================
# M2M AUTHENTICATION
# ========================================
AUTH0_URL=https://topcoder-dev.auth0.com/oauth/token
M2M_CLIENT_ID=your_client_id
M2M_CLIENT_SECRET=your_client_secret
AUTH0_AUDIENCE=https://api.topcoder-dev.com
